{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "MLflowArtifactStoreRead",
        "Effect": "Allow",
        "Action": [
          "s3:GetObject",
          "s3:ListBucket"
        ],
        "Resource": [
          "arn:aws:s3:::twist-mlflow-artifacts",
          "arn:aws:s3:::twist-mlflow-artifacts/*"
        ]
      }
    ]
  }